# HTML files - always revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static assets - cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
