---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="Status | SafePlots"
            description="SafePlots Service Status - Check current system status and maintenance updates."
            canonical="https://safeplots.com/status/"
            keywords="SafePlots Status, System Health, Maintenance"
        />
    </head>
    <body class="page-legal">

        <Header />

        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Information</div>
                <h1 class="section-title">Status</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <div class="legal-text">
                <p>
                    Service status updates will be posted here. If you’re facing
                    an issue, please contact us and we’ll help you quickly.
                </p>

                <h3>Contact</h3>
                <p>
                    Email:
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a
                    ><br />
                    Phone: <a href="tel:+917780391340">+91 77803 91340</a>
                </p>
            </div>
        </main>

        <Footer />

        <script src="/src/scripts/app.js?v=20260210"></script>
        <script src="/src/scripts/posthog-init.js?v=20260210"></script>
    </body>
</html>
