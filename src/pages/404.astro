---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="404 - Page Not Found | SafePlots"
            description="The page you are looking for does not exist. Return to SafePlots home to explore plot monitoring, fencing, and property protection services."
            canonical="https://safeplots.com/404/"
            keywords="404, Page Not Found, SafePlots"
            robots="noindex, follow"
        />
    </head>
    <body class="page-legal">
       <Header />

        <main class="container">
            <div class="error-content">
                <div class="error-kicker text-mono">ERROR</div>
                <h1 class="error-code">404</h1>
                <p class="error-message">
                    The plot you are looking for has been moved, removed, or
                    never existed. Let's get you back on safe ground.
                </p>
                <div class="header-actions">
                    <a href="/" class="btn btn-black">Back to Home</a>
                </div>
            </div>
        </main>

        <Footer />

        <PageScripts />
    </body>
</html>
