---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="Cache-Control" content="no-cache, must-revalidate" />
        <meta http-equiv="Pragma" content="no-cache" />
        <meta http-equiv="Expires" content="0" />

        <!-- PWA & Mobile Meta -->
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/src/assets/icons/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/src/assets/icons/favicon-16x16.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/src/assets/icons/apple-touch-icon-180x180.png"
        />
        <meta name="theme-color" content="#ff4400" />
        <link rel="canonical" href="https://safeplots.com/terms/" />

        <!-- SEO Meta Tags -->
        <title>Terms & Conditions | SafePlots</title>
        <meta
            name="description"
            content="SafePlots Terms & Conditions - Service agreement, eligibility, subscription terms, and user responsibilities."
        />
        <meta
            name="keywords"
            content="Terms of Service, SafePlots, Plot Monitoring Agreement, User Terms"
        />
        <meta name="author" content="SafePlots" />
        <meta name="robots" content="index, follow" />

        <!-- Open Graph Tags -->
        <meta property="og:site_name" content="SafePlots" />
        <meta property="og:url" content="https://safeplots.com/terms/" />
        <meta property="og:title" content="Terms & Conditions | SafePlots" />
        <meta
            property="og:description"
            content="SafePlots Terms & Conditions - Service agreement, eligibility, subscription terms, and user responsibilities."
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:image"
            content="https://safeplots.com/assets/images/og-image.png"
        />
        <meta property="og:image:alt" content="SafePlots Dashboard Preview" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Terms & Conditions | SafePlots" />
        <meta
            name="twitter:description"
            content="SafePlots Terms & Conditions - Service agreement, eligibility, subscription terms, and user responsibilities."
        />
        <meta
            name="twitter:image"
            content="https://safeplots.com/assets/images/og-image.png"
        />
        <meta name="twitter:image:alt" content="SafePlots Dashboard Preview" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Space+Mono:wght@400;700&display=swap"
        />

        <!-- CSS -->
        <link rel="stylesheet" href="/src/styles/app.css?v=20260210" />
    </head>
    <body class="page-legal">

        <Header />

        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Legal Agreement</div>
                <h1 class="section-title">Terms & Conditions</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <section class="legal-summary" aria-label="Key Points">
                <h2 class="legal-summary-title text-mono">Key Points</h2>
                <div class="legal-summary-grid">
                    <div class="legal-summary-card">
                        <div class="legal-summary-card-title">
                            Service Agreement
                        </div>
                        <p class="legal-summary-card-desc">
                            Clear deliverables, timelines, and documentation for
                            services we provide.
                        </p>
                    </div>
                    <div class="legal-summary-card">
                        <div class="legal-summary-card-title">Your Rights</div>
                        <p class="legal-summary-card-desc">
                            Transparent pricing and the ability to cancel or
                            modify services as per policy.
                        </p>
                    </div>
                    <div class="legal-summary-card">
                        <div class="legal-summary-card-title">
                            Responsibilities
                        </div>
                        <p class="legal-summary-card-desc">
                            Provide accurate property details and allow access
                            for service delivery.
                        </p>
                    </div>
                </div>
            </section>

            <div class="legal-text">
                <h3>1. Agreement to Terms</h3>
                <p>
                    These Terms and Conditions ("Terms", "Agreement") constitute
                    a legally binding agreement between you ("Customer", "You",
                    "Your") and SafePlots ("Company", "We", "Us", "Our")
                    regarding your access to and use of our website, mobile
                    application, and services. By accessing or using our
                    Services, you agree to be bound by these Terms.
                </p>

                <h3>2. Definitions</h3>
                <ul>
                    <li>
                        <strong>"Services"</strong>: means all plot maintenance,
                        monitoring, and management services provided by
                        SafePlots.
                    </li>
                    <li>
                        <strong>"Subscription"</strong>: means a recurring
                        service plan (Basic, Standard, or Premium).
                    </li>
                    <li>
                        <strong>"One-Time Service"</strong>: means a single
                        engagement for tasks like cleaning or fencing.
                    </li>
                    <li>
                        <strong>"Property"</strong>: means the vacant land for
                        which you have engaged our Services.
                    </li>
                    <li>
                        <strong>"Customer Portal"</strong>: means the online
                        dashboard where you can access reports and photos.
                    </li>
                </ul>

                <h3>3. Eligibility and Account</h3>
                <p>
                    You must be at least 18 years old. You are responsible for
                    maintaining the confidentiality of your account credentials
                    and for all activities that occur under your account.
                </p>

                <h3>4. Services Description</h3>
                <h4>4.1 Subscription Services</h4>
                <p>
                    We offer Basic, Standard, and Premium plans with varying
                    frequencies of visits, reports, and additional services.
                </p>
                <h4>4.2 One-Time Services</h4>
                <p>
                    Includes plot cleaning, boundary wall construction,
                    plantation, and drone surveys.
                </p>
                <h4>4.3 Service Deliverables</h4>
                <p>
                    All services include geo-tagged photos, detailed inspection
                    reports (PDF), and real-time updates via Customer Portal.
                </p>

                <h3>5. Subscription Terms</h3>
                <h4>5.1 Billing</h4>
                <p>
                    Billed monthly in advance. Payment due on start/renewal
                    date.
                </p>
                <h4>5.2 Cancellation</h4>
                <p>
                    Cancel anytime via Customer Portal. Takes effect at end of
                    billing period. No partial refunds.
                </p>

                <h3>6. One-Time Service Terms</h3>
                <p>
                    Full payment in advance required. We may provide a
                    workmanship warranty for certain construction services.
                </p>

                <h3>7. Property Access & Responsibilities</h3>
                <p>
                    You grant SafePlots access to your property for service
                    delivery. You represent you are the legal owner/authorized.
                    You must provide clear access and accurate information.
                </p>

                <h3>8. Service Delivery</h3>
                <p>
                    We aim to conduct visits per plan and provide photo
                    documentation within 24-48 hours. Service delivery may be
                    delayed by force majeure events (weather, restrictions,
                    etc.).
                </p>

                <h3>9. Pricing</h3>
                <p>
                    Prices may change with notice. Fees may be exclusive of
                    taxes.
                </p>

                <h3>10. Refunds</h3>
                <p>See our <a href="/refund-policy/">Refund Policy</a>.</p>

                <h3>11. Intellectual Property</h3>
                <p>
                    All content and reports generated by SafePlots remain our
                    IP. You receive a license to use them for personal property
                    management.
                </p>

                <h3>12. Limitation of Liability</h3>
                <p>
                    We are not liable for encroachments, theft, or damage
                    occurring between visits. Services are provided "AS IS".
                </p>

                <h3>13. Indemnification</h3>
                <p>
                    You agree to indemnify SafePlots against claims arising from
                    your violation of these Terms or property disputes.
                </p>

                <h3>14. Termination</h3>
                <p>
                    You may terminate anytime. We may terminate for non-payment
                    or violations of these Terms.
                </p>

                <h3>15. Dispute Resolution</h3>
                <p>
                    Disputes may be resolved via arbitration in Hyderabad,
                    India. Governed by Indian law.
                </p>

                <h3>16. Contact</h3>
                <p>
                    Email:
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a>
                </p>
            </div>
        </main>

        <Footer />

        <script src="/src/scripts/app.js?v=20260210"></script>
        <script src="/src/scripts/posthog-init.js?v=20260210"></script>
    </body>
</html>
