---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="Accessibility | SafePlots"
            description="SafePlots Accessibility Statement - Our commitment to making our monitoring services accessible to everyone."
            canonical="https://safeplots.com/accessibility/"
            keywords="Accessibility, SafePlots, Inclusive Design, Web Accessibility"
        />
    </head>
    <body class="page-legal">

        <Header />

        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Information</div>
                <h1 class="section-title">Accessibility</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <div class="legal-text">
                <p>
                    SafePlots aims to make our website accessible and usable for
                    as many people as possible.
                </p>

                <h3>What we’re doing</h3>
                <ul>
                    <li>Using clear structure and headings</li>
                    <li>Supporting keyboard navigation</li>
                    <li>Maintaining readable contrast where possible</li>
                </ul>

                <h3>Feedback</h3>
                <p>
                    If you find an accessibility issue or need content in an
                    alternate format, email
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a
                    >.
                </p>
            </div>
        </main>

        <Footer />

        <PageScripts />
    </body>
</html>
