---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="Cookie Policy | SafePlots"
            description="SafePlots Cookie Policy - How we use cookies to improve your experience."
            canonical="https://safeplots.com/cookie-policy/"
            keywords="Cookie Policy, SafePlots, User Data, Tracking"
        />
    </head>
    <body class="page-legal">
        
        <Header />
        
        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Legal Documentation</div>
                <h1 class="section-title">Cookie Policy</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <div class="legal-text">
                <p>
                    This Cookie Policy explains how SafePlots uses cookies and
                    similar technologies on our website.
                </p>

                <h3>1. What are cookies?</h3>
                <p>
                    Cookies are small text files stored on your device to help
                    websites function and, in some cases, to understand usage.
                </p>

                <h3>2. Cookies we use</h3>
                <p>
                    Our marketing site may use strictly necessary cookies for
                    basic functionality. If we add analytics or other
                    non-essential cookies, we will update this policy and
                    provide choices where required.
                </p>

                <h3>3. Managing cookies</h3>
                <p>
                    You can control cookies through your browser settings. Note
                    that blocking certain cookies may impact site functionality.
                </p>

                <h3>4. Contact</h3>
                <p>
                    Questions? Email
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a
                    >.
                </p>
            </div>
        </main>

        <Footer />
        

        <PageScripts />
    </body>
</html>
