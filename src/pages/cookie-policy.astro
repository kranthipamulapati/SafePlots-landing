---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="Cache-Control" content="no-cache, must-revalidate" />
        <meta http-equiv="Pragma" content="no-cache" />
        <meta http-equiv="Expires" content="0" />

        <!-- PWA & Mobile Meta -->
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/src/assets/icons/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/src/assets/icons/favicon-16x16.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/src/assets/icons/apple-touch-icon-180x180.png"
        />
        <meta name="theme-color" content="#ff4400" />
        <link rel="canonical" href="https://safeplots.com/cookie-policy/" />

        <!-- SEO Meta Tags -->
        <title>Cookie Policy | SafePlots</title>
        <meta
            name="description"
            content="SafePlots Cookie Policy - How we use cookies to improve your experience."
        />
        <meta
            name="keywords"
            content="Cookie Policy, SafePlots, User Data, Tracking"
        />
        <meta name="author" content="SafePlots" />
        <meta name="robots" content="index, follow" />

        <!-- Open Graph Tags -->
        <meta property="og:site_name" content="SafePlots" />
        <meta
            property="og:url"
            content="https://safeplots.com/cookie-policy/"
        />
        <meta property="og:title" content="Cookie Policy | SafePlots" />
        <meta
            property="og:description"
            content="SafePlots Cookie Policy - How we use cookies to improve your experience."
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:image"
            content="https://safeplots.com/assets/images/og-image.png"
        />
        <meta property="og:image:alt" content="SafePlots Dashboard Preview" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Cookie Policy | SafePlots" />
        <meta
            name="twitter:description"
            content="SafePlots Cookie Policy - How we use cookies to improve your experience."
        />
        <meta
            name="twitter:image"
            content="https://safeplots.com/assets/images/og-image.png"
        />
        <meta name="twitter:image:alt" content="SafePlots Dashboard Preview" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Space+Mono:wght@400;700&display=swap"
        />

        <!-- CSS -->
        <link rel="stylesheet" href="/src/styles/app.css?v=20260210" />
    </head>
    <body class="page-legal">
        
        <Header />
        
        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Legal Documentation</div>
                <h1 class="section-title">Cookie Policy</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <div class="legal-text">
                <p>
                    This Cookie Policy explains how SafePlots uses cookies and
                    similar technologies on our website.
                </p>

                <h3>1. What are cookies?</h3>
                <p>
                    Cookies are small text files stored on your device to help
                    websites function and, in some cases, to understand usage.
                </p>

                <h3>2. Cookies we use</h3>
                <p>
                    Our marketing site may use strictly necessary cookies for
                    basic functionality. If we add analytics or other
                    non-essential cookies, we will update this policy and
                    provide choices where required.
                </p>

                <h3>3. Managing cookies</h3>
                <p>
                    You can control cookies through your browser settings. Note
                    that blocking certain cookies may impact site functionality.
                </p>

                <h3>4. Contact</h3>
                <p>
                    Questions? Email
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a
                    >.
                </p>
            </div>
        </main>

        <Footer />
        

        <script src="/src/scripts/app.js?v=20260210"></script>
        <script src="/src/scripts/posthog-init.js?v=20260210"></script>
    </body>
</html>
