---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="Security | SafePlots"
            description="SafePlots Security - How we protect your data and reporting vulnerabilities."
            canonical="https://safeplots.com/security/"
            keywords="SafePlots Security, Data Protection, Vulnerability Reporting"
        />
    </head>
    <body class="page-legal">

        <Header />

        <main class="legal-content container">
            <div class="legal-hero">
                <div class="legal-kicker text-mono">Information</div>
                <h1 class="section-title">Security</h1>
                <div class="legal-updated text-mono">
                    Last Updated: January 2026
                </div>
            </div>

            <div class="legal-text">
                <p>
                    We take security seriously and welcome responsible
                    disclosure of vulnerabilities.
                </p>

                <h3>Reporting a vulnerability</h3>
                <p>
                    Please email
                    <a href="mailto:admin@safeplots.com">admin@safeplots.com</a>
                    with:
                </p>
                <ul>
                    <li>Steps to reproduce</li>
                    <li>Impact and affected URLs</li>
                    <li>Any proof-of-concept details</li>
                </ul>

                <h3>What to expect</h3>
                <p>
                    We’ll acknowledge your report and aim to provide updates as
                    we investigate and remediate.
                </p>
            </div>
        </main>

        <Footer />

        <PageScripts />
    </body>
</html>
