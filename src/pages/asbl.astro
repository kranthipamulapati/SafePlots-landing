---
import appCss from "../components/asbl/app.css?url";
import AsblShowcase from "../components/asbl/index.tsx";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <title>ASBL Showcase | SafePlots</title>
        <meta name="robots" content="noindex" />
        <link rel="stylesheet" href={appCss} />
    </head>
    <body>
        <AsblShowcase client:only="react">
            <div
                slot="fallback"
                class="asbl-safe-root flex items-center justify-center bg-slate-950 text-sm text-slate-400"
            >
                Loading map…
            </div>
        </AsblShowcase>
    </body>
</html>
