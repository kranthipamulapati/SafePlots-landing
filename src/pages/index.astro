---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="SafePlots | NRI Plot Monitoring, Fencing & VLT Services Hyderabad"
            description="Trusted NRI plot management & Fencing (Precast/Wire). Services: VLT, Legal, Cleaning & Satellite Monitoring. View Survey Maps & Lakes on our App."
            canonical="https://safeplots.com/"
            keywords="Plot Monitoring, NRI Services, Land Fencing, Vacant Land Tax, Precast Walls, Survey Maps, Hyderabad Real Estate, Property Management, SafePlots"
            includeOrganizationSchema={true}
        />
    </head>
    
    <body>
        <Header />

        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-split">
                <div class="hero-content">
                    <div class="hero-label text-mono">
                        PLOT MANAGEMENT FOR NRI & BUSY PROFESSIONALS
                    </div>

                    <h1 class="hero-title">
                        <span class="text-orange" id="dynamic-text-1"
                            >SAFEGUARD YOUR PLOTS</span
                        ><br />
                        <span id="dynamic-text-2">FROM YOUR HOME</span>
                    </h1>

                    <p class="hero-desc">
                        We combine tech with on-ground expertise to protect your
                        plot from land sharks.
                    </p>

                    <!-- Quick Benefits -->
                    <ul class="hero-benefits text-mono">
                        <li>
                            <span class="benefit-check">✓</span>Fully automated
                            monitoring
                        </li>

                        <li>
                            <span class="benefit-check">✓</span> Remote sensing
                            using satellites
                        </li>

                        <li>
                            <span class="benefit-check">✓</span>
                            Weekly Tax & Registration Checks
                        </li>

                        <li>
                            <span class="benefit-check">✓</span> Instant Risk
                            Alerts
                        </li>

                        <li>
                            <span class="benefit-check">✓</span> Monthly Reports
                        </li>

                        <li>
                            <span class="benefit-check">✓</span> VLT Application
                        </li>
                    </ul>

                    <div class="hero-cta-group">
                        <a
                            href="https://web.safeplots.com"
                            class="btn btn-primary"
                            target="_blank"
                            rel="noopener noreferrer"
                            >GET STARTED &rarr;</a
                        >
                        <a href="/samples" class="btn btn-outline"
                            >VIEW SAMPLES</a
                        >
                    </div>

                    <!-- Stats Bar -->
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <span class="hero-stat-number" data-count="100"
                                >100</span
                            ><span class="stat-plus">+</span>
                            <span class="hero-stat-label">Plots Secured</span>
                        </div>

                        <div class="hero-stat">
                            <span class="hero-stat-number" data-count="50"
                                >50</span
                            ><span class="stat-plus">+</span>
                            <span class="hero-stat-label">Happy Clients</span>
                        </div>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="hero-cards-container">
                        <!-- Card 1: Satellite -->
                        <div class="hero-card hero-card-sat">
                            <div class="card-icon">🛰️</div>
                            <div class="card-label">REMOTE SENSING</div>
                            <div class="card-status text-mono">
                                STATUS: SAFE
                            </div>
                        </div>

                        <!-- Card 2: Fencing -->
                        <div class="hero-card hero-card-wall">
                            <div class="card-icon">🧱</div>
                            <div class="card-label">PRE-CAST WALL</div>
                            <div class="card-status text-mono">
                                Built in 48 Hrs
                            </div>
                        </div>

                        <!-- Card 3: Trust -->
                        <div class="hero-card hero-card-trust">
                            <div class="card-icon">🛡️</div>
                            <div class="card-label">100% SECURE</div>
                            <div class="card-status text-mono">
                                Zero Encroachment
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="how-it-works-section" id="how-it-works">
            <div class="container">
                <h2 class="section-title text-center">HOW IT WORKS?</h2>

                <div class="process-grid">
                    <!-- Step 1 -->
                    <div class="process-card">
                        <div class="process-step-number">01</div>
                        <div class="process-icon text-mono">
                            📂 Data Collection
                        </div>
                        <div class="process-desc text-mono">
                            We collect data from all available sources - user /
                            government / layout developer which may include EC,
                            VLT, coordinates, layout info etc.
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="process-card">
                        <div class="process-step-number">02</div>
                        <div class="process-icon text-mono">🤝 Onboarding</div>
                        <div class="process-desc text-mono">
                            Your plot is added to our platform where you can
                            view all details. We setup monitoring & services
                            schedules based on your requirements.
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="process-card">
                        <div class="process-step-number">03</div>
                        <div class="process-icon text-mono">
                            📍 Initial Visit
                            <span class="text-mono">(optional)</span>
                        </div>
                        <div class="process-desc text-mono">
                            We will physically visit the plot, identify
                            boundaries & assess condition. You will receive a
                            comprehensive report with geotagged photos.
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="process-card">
                        <div class="process-step-number">04</div>
                        <div class="process-icon text-mono">
                            🛰️ Satellite Monitoring
                        </div>
                        <div class="process-desc text-mono">
                            We task high-resolution satellites with revisit time
                            of 5 days to track your plot. We process raw
                            satellite data to perform NDVI analysis to detect
                            anomalies.
                        </div>
                    </div>

                    <!-- Step 5 -->
                    <div class="process-card">
                        <div class="process-step-number">05</div>
                        <div class="process-icon text-mono">
                            📝 EC & VLT Monitoring
                        </div>
                        <div class="process-desc text-mono">
                            We monitor Encumbrance Certificates (EC) weekly &
                            Vacant Land Tax (VLT) dues fortnightly to detect &
                            notify you of any changes.
                        </div>
                    </div>

                    <!-- Step 6 -->
                    <div class="process-card">
                        <div class="process-step-number">06</div>
                        <div class="process-icon text-mono">
                            🪧 FENCING & ID Board (OPTIONAL)
                        </div>
                        <div class="process-desc text-mono">
                            Installation of physical barriers like precast walls
                            or barbed wire & clear ownership signboard on-site
                            to assert possession & deter encroachers.
                        </div>
                    </div>

                    <!-- Step 7 -->
                    <div class="process-card">
                        <div class="process-step-number">07</div>
                        <div class="process-icon text-mono">
                            📅 Scheduled Inspections (optional)
                        </div>
                        <div class="process-desc text-mono">
                            Regular physical visits (Quarterly/Half-yearly) with
                            detailed PDF reports & fresh visual evidence.
                        </div>
                    </div>

                    <!-- Step 8 -->
                    <div class="process-card">
                        <div class="process-step-number">08</div>
                        <div class="process-icon text-mono">
                            🚨 Monthly Reports & Risk Alerts
                        </div>
                        <div class="process-desc text-mono">
                            Receive monthly progress reports and instant alerts
                            for any potential risks detected through monitoring
                            or ground inspections.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why SafePlots Section -->
        <section class="how-it-works-section" id="why-us">
            <div class="container">
                <h2 class="section-title text-center">WHY US?</h2>

                <p class="how-intro text-mono">
                    What differentiates us from others?
                </p>

                <div class="grid-3-col">
                    <!-- Column 1: Monitoring -->
                    <div class="how-col">
                        <h3 class="how-title text-mono">ADVANCED MONITORING</h3>

                        <ul class="how-list text-mono">
                            <li class="how-list-item">
                                <span class="icon">🛰️</span>

                                <div>
                                    <div>REMOTE SENSING SATELLITES</div>

                                    <div class="how-desc">
                                        We are the first company to offer this
                                        feature.
                                    </div>
                                </div>
                            </li>

                            <li class="how-list-item">
                                <span class="icon">📝</span>

                                <div>
                                    <div>FULL AUTOMATION</div>

                                    <div class="how-desc">
                                        Our system does below tasks without
                                        manual intervention:
                                        <ul class="how-sublist">
                                            <li>
                                                Downloading & Processing raw
                                                satellite data every 5 days
                                            </li>

                                            <li>
                                                Weekly Encumbrance certificate
                                                checks
                                            </li>

                                            <li>
                                                Vacant land tax checks every 15
                                                days
                                            </li>

                                            <li>
                                                User notifications via email on
                                                risk detection
                                            </li>

                                            <li>Monthly reports via email</li>
                                        </ul>
                                        With help of automation, we can monitor
                                        plots at high frequency (weekly vs half
                                        yearly in case of competitors).
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Column 2: Features -->
                    <div class="how-col">
                        <h3 class="how-title text-mono">UNIQUE FEATURES</h3>

                        <ul class="how-list text-mono">
                            <li class="how-list-item">
                                <span class="icon">🇮🇳</span>

                                <div>
                                    <div>ALL INDIA SURVEY MAPS</div>

                                    <div class="how-desc">
                                        Access official survey / cadastral maps
                                        of Bhuvan / Dharani / BhuBharati
                                        overlaid on Google Maps.
                                    </div>
                                </div>
                            </li>

                            <li class="how-list-item">
                                <span class="icon">🌊</span>
                                <div>
                                    <div>1000+ HYDERABAD LAKES</div>
                                    <div class="how-desc">
                                        FTL & Buffer zone of lakes overlaid on
                                        Google Maps. Ensure your plot isn't in
                                        restricted water body zones.
                                    </div>
                                </div>
                            </li>

                            <li class="how-list-item">
                                <span class="icon">📊</span>

                                <div>
                                    <div>UNIFIED DASHBOARD</div>

                                    <div class="how-desc">
                                        View all your plots tax, layout,
                                        registration details in one place.
                                        Real-time updates & progress at a
                                        glance.
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Column 3: Services -->
                    <div class="how-col">
                        <h3 class="how-title text-mono">
                            SPECIALIZED SERVICES
                        </h3>

                        <ul class="how-list text-mono">
                            <li class="how-list-item">
                                <span class="icon">🗺️</span>

                                <div>
                                    <div>PLOT FINDER</div>
                                    <div class="how-desc">
                                        Lost track of your plot? We will help
                                        you physically locate your missing plot
                                        using survey maps & on-ground teams.
                                    </div>
                                </div>
                            </li>

                            <li class="how-list-item">
                                <span class="icon">🧹</span>

                                <div>
                                    <div>VLT APPLICATION</div>

                                    <div class="how-desc">
                                        We will apply for VLT application on
                                        your behalf.
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="pricing-plans" id="plans">
            <div class="container">
                <div class="pricing-plans-header">
                    <h2 class="section-title text-center">Plans</h2>

                    <div class="pricing-toggle" data-pricing-toggle>
                        <button
                            class="toggle-btn is-active"
                            type="button"
                            data-billing="monthly"
                            aria-pressed="true"
                        >
                            Monthly
                        </button>
                        <button
                            class="toggle-btn"
                            type="button"
                            data-billing="yearly"
                            aria-pressed="false"
                        >
                            Yearly <span class="toggle-save">Save 15%</span>
                        </button>
                    </div>
                </div>

                <div class="plans-grid">
                    <!-- Digital Shield -->
                    <article class="plan-card">
                        <div class="plan-head">
                            <div class="plan-name">Digital Shield</div>
                            <div class="plan-tag text-mono">
                                A continuously running digital protection layer
                                for your land.
                            </div>
                        </div>

                        <div class="plan-price" aria-label="Price">
                            <span class="price-currency">₹</span>
                            <span
                                class="price-value"
                                data-price
                                data-monthly="199"
                                data-yearly="1999"
                                >199</span
                            >
                            <span class="price-period" data-price-period
                                >/month</span
                            >
                        </div>

                        <ul class="plan-features text-mono">
                            <li>Satellite monitoring - every 5 days</li>
                            <li>Registration check - every 7 days</li>
                            <li>Tax monitoring - every 14 days</li>
                            <li>Google earth updates - monthly</li>
                            <li>Instant alerts via email</li>
                            <li>Monthly summary reports</li>
                            <li>All India survey/cadastral maps</li>
                            <li>1000+ hyderabad lakes</li>
                            <li>Dashboard access</li>
                        </ul>

                        <a
                            href="https://web.safeplots.com"
                            class="btn btn-primary plan-cta"
                            target="_blank"
                            rel="noopener noreferrer"
                            >Start Digital Shield</a
                        >
                    </article>

                    <!-- Protection Pro -->
                    <article class="plan-card is-featured">
                        <div class="plan-head">
                            <div class="plan-name">Protection Pro</div>
                            <div class="plan-tag text-mono">
                                Digital Shield + Ground visits
                            </div>
                        </div>

                        <div class="plan-price" aria-label="Price">
                            <span class="price-currency">₹</span>
                            <span
                                class="price-value"
                                data-price
                                data-monthly="999"
                                data-yearly="9999"
                                >999</span
                            >
                            <span class="price-period" data-price-period
                                >/month</span
                            >
                        </div>

                        <ul class="plan-features text-mono">
                            <li>Includes all Digital Shield features</li>
                            <li>2 scheduled visits per year</li>
                            <li>Detailed report per visit</li>
                            <li>ID board</li>
                            <li>Geotagged photos</li>
                        </ul>

                        <a
                            href="https://web.safeplots.com"
                            class="btn btn-outline plan-cta"
                            target="_blank"
                            rel="noopener noreferrer"
                            >Start Protection Pro</a
                        >
                    </article>

                    <!-- Custom -->
                    <article class="plan-card plan-card-custom">
                        <div class="plan-head">
                            <div class="plan-name">Custom</div>
                            <div class="plan-tag text-mono">
                                Tailored for multiple plots / custom needs
                            </div>
                        </div>

                        <div class="plan-price is-custom" aria-label="Price">
                            <span class="price-value">Custom</span>
                            <span class="price-period">/quote</span>
                        </div>

                        <ul class="plan-features text-mono">
                            <li>Custom monitoring mix</li>
                            <li>Custom on-ground visits</li>
                            <li>Bundle services (cleaning/fencing/etc.)</li>
                            <li>Multi-plot discounts</li>
                            <li>Dedicated support</li>
                        </ul>

                        <a href="#contact" class="btn btn-outline plan-cta"
                            >Request Quote</a
                        >
                    </article>
                </div>

                <p class="pricing-fineprint text-mono text-center">
                    Prices shown are starting points. Site-specific work
                    (materials, travel, fencing type) may affect final quotes.
                </p>
            </div>
        </section>

        <!-- One-Time Services -->
        <section class="pricing-services" id="services">
            <div class="container">
                <h2 class="section-title text-center">Services</h2>
                <p class="pricing-note text-mono text-center">
                    Add any service with any plan. Pay only when you need it.
                </p>

                <div class="service-cards">
                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🔍</div>
                            <div class="service-title">Find my plot</div>
                        </div>

                        <div class="service-price text-mono">
                            ₹2,499 - 4,999
                        </div>

                        <p class="service-desc text-mono">
                            Lost track of your plot? We'll do on-ground search
                            to locate your plot & share geotagged proof.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="Find my plot"
                            >Get Quote</a
                        >
                    </article>

                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🚶‍♂️</div>
                            <div class="service-title">Plot Visit</div>
                        </div>

                        <div class="service-price text-mono">
                            ₹2,499 – ₹4,999
                        </div>

                        <p class="service-desc text-mono">
                            A physical site inspection to assess your plot's
                            condition & share detailed inspection report with
                            geotagged photos.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="Plot Visit"
                            >Get Quote</a
                        >
                    </article>

                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🧹</div>
                            <div class="service-title">Plot Cleaning</div>
                        </div>

                        <div class="service-price text-mono">₹1,999-4,999</div>

                        <p class="service-desc text-mono">
                            Weed & debris clearing so your site stays visible,
                            with before/after photos.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="Full Plot Cleaning"
                            >Get Quote</a
                        >
                    </article>

                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🧱</div>
                            <div class="service-title">Fencing</div>
                        </div>

                        <div class="service-price text-mono">
                            ₹19,999 – ₹49,999
                        </div>

                        <p class="service-desc text-mono">
                            Barbed wire fencing starts at 20k/100 sq.yards &
                            Precast compound walls at 50k/100 sq.yards.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="Fencing"
                            >Get Quote</a
                        >
                    </article>

                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🚁</div>
                            <div class="service-title">
                                Drone Video & Photos
                            </div>
                        </div>

                        <div class="service-price text-mono">
                            ₹2,499 – ₹4,999
                        </div>

                        <p class="service-desc text-mono">
                            Aerial photos & video for a clear view of plot &
                            surrounding area.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="Drone Video & Photos"
                            >Get Quote</a
                        >
                    </article>

                    <article class="service-card">
                        <div class="service-header">
                            <div class="service-icon">🪧</div>
                            <div class="service-title">ID Board</div>
                        </div>

                        <div class="service-price text-mono">₹999 – ₹2,499</div>

                        <p class="service-desc text-mono">
                            Install an ID board on-site to identify ownership &
                            deter encroachment.
                        </p>

                        <a
                            href="#contact"
                            class="btn btn-outline service-cta"
                            data-service="ID Board"
                            >Get Quote</a
                        >
                    </article>
                </div>
            </div>
        </section>

