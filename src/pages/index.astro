        <!-- Send a Message -->
        <section class="message-section" id="contact">
            <div class="container">
                <h2 class="section-title text-center">CONTACT</h2>

                <!-- Contact Info Card -->
                <div
                    class="bento-card bg-white message-card contact-separation"
                >
                    <!-- Contact Info Section -->
                    <div class="contact-info-block">
                        <div
                            class="card-badge text-mono contact-badge-spacing bg-black text-white"
                        >
                            📞 CONTACT US
                        </div>

                        <div class="contact-grid">
                            <div class="contact-item">
                                <span class="text-mono contact-label"
                                    >PHONE / WHATSAPP</span
                                >
                                <a
                                    href="tel:+917780391340"
                                    class="contact-link"
                                >
                                    +91 77803 91340
                                </a>
                            </div>

                            <div class="contact-item">
                                <span class="text-mono contact-label"
                                    >EMAIL</span
                                >
                                <a
                                    href="mailto:admin@safeplots.com"
                                    class="contact-link"
                                >
                                    admin@safeplots.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Message Form Card -->
                <div class="bento-card bg-white message-card">
                    <div class="card-badge text-mono bg-black text-white">
                        ✍️ SEND A MESSAGE
                    </div>

                    <div class="message-content">
                        <form class="contact-form" id="contactForm">
                            <label class="form-field">
                                <span class="form-label text-mono"
                                    >FULL NAME</span
                                >
                                <input
                                    class="form-input"
                                    name="name"
                                    autocomplete="name"
                                    required
                                    placeholder="Your name"
                                />
                            </label>

                            <label class="form-field">
                                <span class="form-label text-mono">PHONE</span>
                                <input
                                    class="form-input"
                                    name="phone"
                                    type="tel"
                                    autocomplete="tel"
                                    required
                                    placeholder="Enter your phone number"
                                />
                            </label>

                            <label class="form-field">
                                <span class="form-label text-mono">EMAIL</span>
                                <input
                                    class="form-input"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    placeholder="name@example.com"
                                />
                            </label>

                            <label class="form-field">
                                <span class="form-label text-mono"
                                    >MESSAGE</span
                                >
                                <textarea
                                    class="form-textarea"
                                    name="message"
                                    rows="4"
                                    placeholder="Tell us your plot location + what you need (monitoring/fencing/legal/etc)."
                                ></textarea>
                            </label>

                            <!-- Honeypot (spam) -->
                            <input
                                class="hp-field"
                                type="text"
                                name="company"
                                tabindex="-1"
                                autocomplete="off"
                                aria-hidden="true"
                            />

                            <button
                                class="btn btn-primary form-submit"
                                type="submit"
                            >
                                Submit &rarr;
                            </button>

                            <p
                                class="form-status text-mono"
                                role="status"
                                aria-live="polite"
                            ></p>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <Footer />

        <PageScripts />
    </body>
</html>
