---
    import Header from '../components/Header.astro';
    import Footer from '../components/Footer.astro';
    import SeoHead from '../components/SeoHead.astro';
    import PageScripts from '../components/PageScripts.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title="FAQ | SafePlots - Frequently Asked Questions"
            description="Got questions? Find answers about SafePlots services, Plans, NRI plot monitoring, and more."
            canonical="https://safeplots.com/faq/"
            keywords="SafePlots FAQ, Plot Monitoring Questions, NRI Services Help, Real Estate Management Queries"
        />
    </head>
    <body class="page-faq">
        <Header />

        <section class="hero min-h-50vh items-center">
            <div class="container text-center">
                <h1 class="hero-title">
                    FREQUENTLY ASKED<br /><span class="text-orange"
                        >QUESTIONS</span
                    >
                </h1>
                <p class="hero-desc mx-auto">
                    Everything you need to know about SafePlots services, plans,
                    and how we protect your land.
                </p>
            </div>
        </section>

        <section class="faq-section py-80">
            <div class="container max-w-900">
                <div class="faq-grid flex-col gap-20">
                    <details class="faq-item faq-item-details">
                        <summary class="faq-summary">
                            CAN I MONITOR MULTIPLE PLOTS?
                            <span class="icon">▼</span>
                        </summary>
                        <div class="faq-content faq-content-box">
                            Yes! Our "Unified Dashboard" allows you to add and
                            manage as many plots as you own. You can see the
                            status of all your properties in one single view. We
                            also offer custom plans for multi-plot owners.
                        </div>
                    </details>

                    <details class="faq-item faq-item-details">
                        <summary class="faq-summary">
                            WHAT CITIES DO YOU COVER?
                            <span class="icon">▼</span>
                        </summary>
                        <div class="faq-content faq-content-box">
                            Currently, we focus on Hyderabad, Vijayawada,
                            Guntur, and Vizag. We are rapidly expanding to other
                            major cities in India. If you have a plot elsewhere,
                            contact us, and we might still be able to help with
                            satellite monitoring.
                        </div>
                    </details>

                    <details class="faq-item faq-item-details">
                        <summary class="faq-summary">
                            DO YOU PROVIDE LEGAL ASSISTANCE?
                            <span class="icon">▼</span>
                        </summary>
                        <div class="faq-content faq-content-box">
                            Yes, we monitor Encumbrance Certificates (EC) and
                            Vacant Land Tax (VLT) status. If legal issues arise,
                            we can connect you with trusted property lawyers in
                            our network, but we are primarily a monitoring and
                            management service.
                        </div>
                    </details>

                    <details class="faq-item faq-item-details">
                        <summary class="faq-summary">
                            HOW OFTEN ARE PHYSICAL VISITS CONDUCTED?
                            <span class="icon">▼</span>
                        </summary>
                        <div class="faq-content faq-content-box">
                            It depends on your plan. "Digital Shield" is purely
                            digital (satellite + records). "Protection Pro"
                            includes 2 scheduled physical visits per year. You
                            can also request on-demand "One-Time Visits"
                            whenever you like for an additional fee.
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <section class="cta-section bg-secondary text-inverse py-80">
            <div class="container text-center">
                <h2 class="section-title text-inverse">
                    STILL HAVE QUESTIONS?
                </h2>
                <p class="text-grey mb-30">
                    Our team is ready to help you secure your assets.
                </p>
                <a href="/#contact" class="btn btn-primary"
                    >Contact Us</a
                >
            </div>
        </section>

        <Footer />

        <PageScripts />
    </body>
</html>
