{
    "name": "landing-new",
    "type": "module",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "purgecss": "npx purgecss --css src/styles/app.css --content \"src/**/*.astro\" \"src/scripts/**/*.js\" --safelist active dropdown-open fade-out --output ._purge_tmp && node -e \"const fs=require('node:fs');fs.copyFileSync('._purge_tmp/app.css','src/styles/app.css');fs.rmSync('._purge_tmp',{recursive:true,force:true});\""
    },
    "dependencies": {
        "@astrojs/react": "5.0.7",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "astro": "6.4.2",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@playwright/test": "1.59.1",
        "@types/node": "25.6.0",
        "wrangler": "4.85.0"
    }
}
